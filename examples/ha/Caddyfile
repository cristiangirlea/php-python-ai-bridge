# Internal HTTP only; put the operator's TLS boundary in front for cross-host clients.
{
    admin off
    auto_https off
    servers {
        max_header_size 16384
        timeouts {
            read_header 5s
            read_body 5s
            write 10s
            idle 5s
        }
    }
}

:8080 {
    request_body {
        max_size 262144
    }
    # Reject declared oversize before dialing; streaming limits alone can race the worker's response.
    @oversized header_regexp Content-Length ^0*(26214[5-9]|2621[5-9][0-9]|262[2-9][0-9]{2}|26[3-9][0-9]{3}|2[7-9][0-9]{4}|[3-9][0-9]{5}|[1-9][0-9]{6,})$
    handle @oversized {
        header Content-Type application/json
        header Cache-Control no-store
        respond `{"error":{"code":"body_too_large","message":"Request exceeds 262144 bytes"}}` 413
    }
    @submit {
        method POST
        path /v1/jobs
    }
    handle @submit {
        reverse_proxy worker-a:8090 worker-b:8090 {
            lb_policy round_robin
            request_buffers 262145
        }
    }
    @a path_regexp a "^/v1/jobs/a-[a-f0-9]{32}(/cancel)?$"
    handle @a {
        reverse_proxy worker-a:8090 {
            request_buffers 262145
        }
    }
    @b path_regexp b "^/v1/jobs/b-[a-f0-9]{32}(/cancel)?$"
    handle @b {
        reverse_proxy worker-b:8090 {
            request_buffers 262145
        }
    }
    handle {
        reverse_proxy worker-a:8090 worker-b:8090 {
            lb_policy round_robin
            request_buffers 262145
        }
    }
}
