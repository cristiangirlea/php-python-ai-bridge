# The token passes through to the worker, which checks it; `tls internal` signs with a local CA the client must trust.
{
    admin off
    # Only the port 80 redirect goes: `auto_https off` would also stop Caddy issuing the `tls internal` certificate.
    auto_https disable_redirects
    skip_install_trust
    servers {
        max_header_size 16384
        timeouts {
            read_header 5s
            read_body 5s
            write 10s
            idle 5s
        }
    }
}

tls-proxy:8443 {
    tls internal
    # Reject declared oversize before dialing; streaming limits alone can race the worker's response.
    @oversized header_regexp Content-Length ^0*(26214[5-9]|2621[5-9][0-9]|262[2-9][0-9]{2}|26[3-9][0-9]{3}|2[7-9][0-9]{4}|[3-9][0-9]{5}|[1-9][0-9]{6,})$
    handle @oversized {
        header Content-Type application/json
        header Cache-Control no-store
        respond `{"error":{"code":"body_too_large","message":"Request exceeds 262144 bytes"}}` 413
    }
    handle {
        request_body {
            max_size 262144
        }
        reverse_proxy worker:8090 {
            # Buffer bounded uploads before dialing to reduce races with early worker refusals.
            request_buffers 262145
        }
    }
}
