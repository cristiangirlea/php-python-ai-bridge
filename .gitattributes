* text=auto eol=lf
# Hook scripts run under sh, which breaks on CRLF line endings.
.claude/hooks/* text eol=lf

# Consumers need only the PHP client, its composer.json, license, changelog and documentation in dist archives.
/.claude export-ignore
/.gitattributes export-ignore
/.github export-ignore
/.gitignore export-ignore
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/CONTRIBUTING.md export-ignore
/composer.lock export-ignore
/docker export-ignore
/examples export-ignore
/mcp_server export-ignore
/phpstan-baseline.neon export-ignore
/phpstan.neon export-ignore
/pyproject.toml export-ignore
/requirements-dev.lock export-ignore
/requirements-dev.txt export-ignore
/requirements-mcp.lock export-ignore
/requirements-mcp.txt export-ignore
/requirements-model.lock export-ignore
/requirements-model.txt export-ignore
/scripts export-ignore
/tests export-ignore
/worker export-ignore
