{
  "__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"}],
  "title": "PHP-Python AI Bridge",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "panels": [
    {"id": 1, "title": "Terminal jobs per second", "type": "timeseries", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "sum by (task, status) (rate(bridge_jobs_total[5m]))", "legendFormat": "{{task}} {{status}}"}]},
    {"id": 2, "title": "Queue and running", "type": "timeseries", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "B", "expr": "bridge_queue_depth", "legendFormat": "queue"}, {"refId": "C", "expr": "bridge_jobs_running", "legendFormat": "running"}]},
    {"id": 3, "title": "Job latency by task (seconds)", "type": "timeseries", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "D", "expr": "histogram_quantile(0.5, sum by (le, task) (rate(bridge_job_duration_seconds_bucket[5m])))", "legendFormat": "{{task}} p50"}, {"refId": "E", "expr": "histogram_quantile(0.95, sum by (le, task) (rate(bridge_job_duration_seconds_bucket[5m])))", "legendFormat": "{{task}} p95"}, {"refId": "F", "expr": "histogram_quantile(0.99, sum by (le, task) (rate(bridge_job_duration_seconds_bucket[5m])))", "legendFormat": "{{task}} p99"}]},
    {"id": 4, "title": "Queue latency by task (seconds)", "type": "timeseries", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "G", "expr": "histogram_quantile(0.5, sum by (le, task) (rate(bridge_job_queue_seconds_bucket[5m])))", "legendFormat": "{{task}} p50"}, {"refId": "H", "expr": "histogram_quantile(0.95, sum by (le, task) (rate(bridge_job_queue_seconds_bucket[5m])))", "legendFormat": "{{task}} p95"}, {"refId": "I", "expr": "histogram_quantile(0.99, sum by (le, task) (rate(bridge_job_queue_seconds_bucket[5m])))", "legendFormat": "{{task}} p99"}]},
    {"id": 5, "title": "Pool", "type": "timeseries", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "J", "expr": "bridge_pool_size", "legendFormat": "size"}, {"refId": "K", "expr": "bridge_pool_ready", "legendFormat": "ready"}, {"refId": "L", "expr": "bridge_concurrency", "legendFormat": "configured"}]},
    {"id": 6, "title": "429s per second by owner", "type": "timeseries", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "M", "expr": "sum by (owner) (rate(bridge_submissions_rejected_total[5m]))", "legendFormat": "{{owner}}"}]},
    {"id": 7, "title": "Retained results and capacity", "type": "timeseries", "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "N", "expr": "bridge_results_retained", "legendFormat": "{{instance}} retained"}, {"refId": "O", "expr": "bridge_result_capacity", "legendFormat": "{{instance}} capacity"}]}
  ]
}
