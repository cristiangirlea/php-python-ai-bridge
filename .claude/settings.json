{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(docker compose -f docker/compose.yaml config)",
      "Bash(docker compose -f docker/compose.yaml --profile * config)",
      "Bash(docker compose -f docker/compose.yaml run --rm --no-deps python-tests)",
      "Bash(docker compose -f docker/compose.yaml run --rm --no-deps php-tests)",
      "Bash(docker compose -f docker/compose.yaml run --rm --no-deps php-tests sh -ec *)",
      "Bash(docker compose -f docker/compose.yaml run --rm --no-deps php-integration)",
      "Bash(docker compose -f docker/compose.yaml run --rm --no-deps integration)",
      "Bash(docker compose -f docker/compose.yaml run --rm --no-deps php-example)",
      "Bash(docker compose -f docker/compose.yaml run --rm --no-deps mcp-fetcher)",
      "Bash(docker compose -f docker/compose.yaml run --rm --no-deps mcp-tests)",
      "Bash(docker compose -f docker/compose.yaml run --rm --no-deps composer-install)",
      "Bash(docker compose -f docker/compose.yaml run --rm --no-deps php-fetcher)",
      "Bash(docker compose -f docker/compose.yaml run --rm --no-deps php-analysis)",
      "Bash(docker compose -f docker/compose.yaml up -d worker frankenphp fault-worker hostile)",
      "Bash(docker compose -f docker/compose.yaml up -d worker frankenphp)",
      "Bash(docker compose -f docker/compose.yaml down)",
      "Bash(docker compose -f docker/compose.yaml down *)",
      "Bash(docker compose -f docker/compose.yaml --profile * down)",
      "Bash(docker compose -f docker/compose.yaml --profile * down *)",
      "Bash(docker compose -f docker/compose.yaml logs *)",
      "Bash(docker compose -f docker/compose.yaml --profile * logs *)",
      "Bash(docker compose -f docker/compose.yaml ps *)",
      "Bash(docker compose -f docker/compose.yaml --profile * ps *)",
      "Bash(docker compose version)",
      "Bash(docker version)",
      "Bash(docker ps *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git grep *)",
      "Bash(git blame *)",
      "Bash(git worktree list *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh workflow view *)",
      "Bash(gh workflow list *)",
      "PowerShell(docker compose -f docker/compose.yaml config)",
      "PowerShell(docker compose -f docker/compose.yaml --profile * config)",
      "PowerShell(docker compose -f docker/compose.yaml run --rm --no-deps python-tests)",
      "PowerShell(docker compose -f docker/compose.yaml run --rm --no-deps php-tests)",
      "PowerShell(docker compose -f docker/compose.yaml run --rm --no-deps php-tests sh -ec *)",
      "PowerShell(docker compose -f docker/compose.yaml run --rm --no-deps php-integration)",
      "PowerShell(docker compose -f docker/compose.yaml run --rm --no-deps integration)",
      "PowerShell(docker compose -f docker/compose.yaml run --rm --no-deps php-example)",
      "PowerShell(docker compose -f docker/compose.yaml run --rm --no-deps mcp-fetcher)",
      "PowerShell(docker compose -f docker/compose.yaml run --rm --no-deps mcp-tests)",
      "PowerShell(docker compose -f docker/compose.yaml run --rm --no-deps composer-install)",
      "PowerShell(docker compose -f docker/compose.yaml run --rm --no-deps php-fetcher)",
      "PowerShell(docker compose -f docker/compose.yaml run --rm --no-deps php-analysis)",
      "PowerShell(docker compose -f docker/compose.yaml up -d worker frankenphp fault-worker hostile)",
      "PowerShell(docker compose -f docker/compose.yaml up -d worker frankenphp)",
      "PowerShell(docker compose -f docker/compose.yaml down)",
      "PowerShell(docker compose -f docker/compose.yaml down *)",
      "PowerShell(docker compose -f docker/compose.yaml --profile * down)",
      "PowerShell(docker compose -f docker/compose.yaml --profile * down *)",
      "PowerShell(docker compose -f docker/compose.yaml logs *)",
      "PowerShell(docker compose -f docker/compose.yaml --profile * logs *)",
      "PowerShell(docker compose -f docker/compose.yaml ps *)",
      "PowerShell(docker compose -f docker/compose.yaml --profile * ps *)",
      "PowerShell(docker compose version)",
      "PowerShell(docker version)",
      "PowerShell(docker ps *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git grep *)",
      "PowerShell(git blame *)",
      "PowerShell(git worktree list *)",
      "PowerShell(git branch)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git branch --list *)",
      "PowerShell(git branch -a)",
      "PowerShell(git branch -r)",
      "PowerShell(git branch -v)",
      "PowerShell(git branch -vv)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh pr diff *)",
      "PowerShell(gh issue view *)",
      "PowerShell(gh issue list *)",
      "PowerShell(gh run view *)",
      "PowerShell(gh run list *)",
      "PowerShell(gh workflow view *)",
      "PowerShell(gh workflow list *)"
    ],
    "ask": [
      "Bash(gh workflow run *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh api -f*)",
      "Bash(gh api -F*)",
      "Bash(gh api * -f*)",
      "Bash(gh api * -F*)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *--input*)",
      "Bash(docker compose -f docker/compose.yaml run --rm --no-deps fetcher)",
      "PowerShell(gh workflow run *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh api -f*)",
      "PowerShell(gh api -F*)",
      "PowerShell(gh api * -f*)",
      "PowerShell(gh api * -F*)",
      "PowerShell(gh api *--field*)",
      "PowerShell(gh api *--raw-field*)",
      "PowerShell(gh api *--input*)",
      "PowerShell(docker compose -f docker/compose.yaml run --rm --no-deps fetcher)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(~/.claude/.credentials.json)",
      "Bash(gh release *)",
      "Bash(gh pr merge *--auto*)",
      "Bash(gh pr merge *--admin*)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push *--force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * *:main)",
      "Bash(git push *--tags*)",
      "Bash(git push *--follow-tags*)",
      "Bash(git push *refs/tags/*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--delete*)",
      "Bash(git tag *)",
      "Bash(git grep *-O*)",
      "Bash(git grep *--open-files-in-pager*)",
      "Bash(git * --output*)",
      "Bash(git * --output=*)",
      "Bash(git diff *--no-index*)",
      "Bash(git push *refs/heads/main*)",
      "PowerShell(gh release *)",
      "PowerShell(gh pr merge *--auto*)",
      "PowerShell(gh pr merge *--admin*)",
      "PowerShell(gh api *-X*)",
      "PowerShell(gh api *--method*)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(git push * +*)",
      "PowerShell(git push * main)",
      "PowerShell(git push * *:main)",
      "PowerShell(git push *--tags*)",
      "PowerShell(git push *--follow-tags*)",
      "PowerShell(git push *refs/tags/*)",
      "PowerShell(git push *--mirror*)",
      "PowerShell(git push *--delete*)",
      "PowerShell(git tag *)",
      "PowerShell(git grep *-O*)",
      "PowerShell(git grep *--open-files-in-pager*)",
      "PowerShell(git * --output*)",
      "PowerShell(git * --output=*)",
      "PowerShell(git diff *--no-index*)",
      "PowerShell(git push *refs/heads/main*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/push-guard.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/repo-rules.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
